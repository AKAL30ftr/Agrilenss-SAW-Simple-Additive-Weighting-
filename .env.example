# OpenAI-compatible chatbot settings.
# OPENAI_API_KEY stays server-side and is used only by /api/recommend.
OPENAI_API_KEY="YOUR_API_KEY"

# Optional when using a custom OpenAI-compatible provider.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Any chat-completions compatible model from your provider.
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
